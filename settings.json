{
  "DiagnosticPort": {
    "ConnectionMode": "Listen",
    "EndpointName": "dotnet-monitor-pipe"
  },
  "Storage": {
    "DefaultSharedPath": "C:\\tmp\\dotnet-monitor"
  },
  "Egress": {
    "FileSystem": {
      "artifacts": {
        "directoryPath": "C:\\tmp\\dotnet-monitor\\artifacts",
        "intermediateDirectoryPath": "C:\\tmp\\dotnet-monitor\\intermediate"
      }
    }
  },
  "CollectionRules": {
    "ThreadPoolStarvation": {
      "Trigger": {
        "Type": "EventCounter",
        "Settings": {
          "ProviderName": "System.Runtime",
          "CounterName": "threadpool-completed-items-count",
          "LessThan": 1,
          "SlidingWindowDuration": "00:00:02"
        }
      },
      "Actions": [
        {
          "Type": "CollectTrace",
          "Settings": {
            "Profile": "Cpu",
            "Duration": "00:00:10",
            "Egress": "artifacts"
          }
        },
        {
          "Type": "CollectDump",
          "Settings": {
            "Type": "Full",
            "Egress": "artifacts"
          }
        }
      ],
      "Limits": {
        "ActionCount": 3,
        "ActionCountSlidingWindowDuration": "00:10:00"
      }
    },
    "HighLockContention": {
      "Trigger": {
        "Type": "EventCounter",
        "Settings": {
          "ProviderName": "System.Runtime",
          "CounterName": "monitor-lock-contention-count",
          "GreaterThan": 100,
          "SlidingWindowDuration": "00:00:03"
        }
      },
      "Actions": [
        {
          "Type": "CollectTrace",
          "Settings": {
            "Profile": "Cpu",
            "Duration": "00:00:10",
            "Egress": "artifacts"
          }
        }
      ],
      "Limits": {
        "ActionCount": 3,
        "ActionCountSlidingWindowDuration": "00:10:00"
      }
    },
    "GCPressure": {
      "Trigger": {
        "Type": "EventCounter",
        "Settings": {
          "ProviderName": "System.Runtime",
          "CounterName": "time-in-gc",
          "GreaterThan": 50,
          "SlidingWindowDuration": "00:00:05"
        }
      },
      "Actions": [
        {
          "Type": "CollectTrace",
          "Settings": {
            "Profile": "Cpu",
            "Duration": "00:00:10",
            "Egress": "artifacts"
          }
        },
        {
          "Type": "CollectGCDump",
          "Settings": {
            "Egress": "artifacts"
          }
        }
      ],
      "Limits": {
        "ActionCount": 2,
        "ActionCountSlidingWindowDuration": "00:10:00"
      }
    },
    "ThreadExplosion": {
      "Trigger": {
        "Type": "EventCounter",
        "Settings": {
          "ProviderName": "System.Runtime",
          "CounterName": "threadpool-thread-count",
          "GreaterThan": 100,
          "SlidingWindowDuration": "00:00:05"
        }
      },
      "Actions": [
        {
          "Type": "CollectTrace",
          "Settings": {
            "Profile": "Cpu",
            "Duration": "00:00:10",
            "Egress": "artifacts"
          }
        },
        {
          "Type": "CollectDump",
          "Settings": {
            "Type": "Full",
            "Egress": "artifacts"
          }
        }
      ],
      "Limits": {
        "ActionCount": 2,
        "ActionCountSlidingWindowDuration": "00:30:00"
      }
    },
    "Startup": {
      "Trigger": {
        "Type": "Startup"
      },
      "Actions": [
        {
          "Type": "CollectTrace",
          "Settings": {
            "Profile": "Cpu",
            "Duration": "00:00:05",
            "Egress": "artifacts"
          }
        }
      ],
      "Limits": {
        "ActionCount": 1
      }
    }
  }
}
