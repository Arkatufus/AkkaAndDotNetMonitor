{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AkkaOptions": {
    "Remote": {
      "HostName": "0.0.0.0",
      "Port": 4055,
      "PublicHostName": "localhost"
    },
    "Cluster": {
      "Roles": [ "worker" ]
    },
    "Management": {
      "BindHostName": "0.0.0.0",
      "HostName": "localhost",
      "Port": 8558
    },
    "ClusterBootstrap": {
      "ContactPointDiscovery": {
        "ServiceName": "akka-threadpool-demo",
        "RequiredContactPointsNr": 1
      },
      "ContactPoint": {
        "FilterOnFallbackPort": false
      }
    },
    "Discovery": {
      "HostName": "localhost",
      "Port": 8558,
      "ServiceName": "akka-threadpool-demo"
    }
  }
}
